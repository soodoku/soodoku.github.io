{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "const": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "$schema",
    "version",
    "sections",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "resource": {
              "type": "string",
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "resource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "enum": [
                "br",
                "span",
                "i",
                "p",
                "b",
                "em",
                "strong",
                "sup",
                "sub"
              ]
            },
            "class": {
              "enum": [
                "highlight",
                "coauthor",
                "resource-links",
                "entry-icon"
              ]
            },
            "children": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "tag"
          ],
          "additionalProperties": false
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "repo",
        "ref",
        "path"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "pdf",
            "repository",
            "webpage",
            "dataset",
            "documentation",
            "video"
          ]
        },
        "role": {
          "enum": [
            "manuscript",
            "appendix",
            "code",
            "replication",
            "data",
            "documentation",
            "demo",
            "blog",
            "press",
            "related"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "new_tab": {
          "type": "boolean"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      },
      "required": [
        "id",
        "kind",
        "role",
        "url"
      ],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "project",
            "paper",
            "software",
            "dataset",
            "blog"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "primary_resource": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "description": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "related_entries": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          }
        },
        "class": {
          "enum": [
            "paper-toggle"
          ]
        },
        "authors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "publication": {
          "type": "object",
          "properties": {
            "venue": {
              "type": "string",
              "minLength": 1
            },
            "year": {
              "type": "integer",
              "minimum": 1800,
              "maximum": 2999
            }
          },
          "required": [
            "venue",
            "year"
          ],
          "additionalProperties": false
        },
        "supporting": {
          "type": "object",
          "properties": {
            "related": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            },
            "press": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/node"
                }
              }
            }
          },
          "minProperties": 1,
          "additionalProperties": false
        },
        "description_source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "minLength": 1
            },
            "kind": {
              "enum": [
                "manuscript",
                "repository-readme"
              ]
            },
            "reviewed_on": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "text_type": {
              "const": "summary"
            }
          },
          "required": [
            "url",
            "kind",
            "reviewed_on",
            "text_type"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "kind",
        "title",
        "primary_resource",
        "resources",
        "summary",
        "description"
      ],
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "children": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "entry": {
                    "type": "string",
                    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                  }
                },
                "required": [
                  "entry"
                ],
                "additionalProperties": false
              },
              {
                "$ref": "#/$defs/section"
              }
            ]
          }
        }
      },
      "required": [
        "id",
        "title",
        "children"
      ],
      "additionalProperties": false
    }
  }
}
